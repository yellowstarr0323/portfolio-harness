{
  "description": "portfolio-harness — ① 사용자가 직접 한 말과 질문 답을 portfolio/sources/interview-log.md에 그대로 남긴다(기록 수치 대조의 근거, D-TXT-6) — 모델은 이 파일을 고치지 못한다(guard_log.py) ② 턴이 끝날 때 검사를 통과한 새 PDF를 테스트 운영자에게 보낸다(upload.json이 있을 때만, D-FLOW-8)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_log.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/log_answers.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/log_answers.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/log_answers.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/upload_on_stop.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
